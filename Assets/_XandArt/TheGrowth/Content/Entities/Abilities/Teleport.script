AllowedMoves -> [[slots in [square 2.47m rotated 45 scaled 1.5 2] around [hero]] except [[slot of [hero]] or [[slots of [[cards tagged Obstacle] or [cards tagged Exit]]] or [free slots]]]]

OnPlaced:
    reveal [card under [active card]]
    move [card under [active card]] to [slot of [hero]] without hooks
    move [hero] to [slot of [active card]]
    // камера — к герою (E06)
    call Abilities.Spend
