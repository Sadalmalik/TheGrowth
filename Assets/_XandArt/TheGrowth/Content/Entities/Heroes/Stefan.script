AllowedMoves -> [[slots in [square 1.06m rotated 45 scaled 1.5 2] around [active card]] except [[slot of [active card]] or [free slots]]]

OnPlacedFirstTime:
    // камера — к герою (E06)
    call Cards.RevealAround
    set turns left to 25

OnPlaced:
    // камера — к герою (E06)
    call Cards.RevealAround
    call Cards.HeroStep
