AllowedMoves -> [[slots in [[line 0 2.25m] or [line 90 3m]] around [active card]] except [[slot of [active card]] or [[slots of [[cards tagged Monster] or [cards tagged Obstacle]]] or [free slots]]]]

OnPlacedFirstTime:
    call Cards.RevealAround
    // камера — к герою (E06)
    // диалог Tutorial_Game (E12)
    set turns left to 25

OnPlaced:
    // камера — к герою (E06)
    call Cards.RevealAround
    if [[turns left] <= 0]
        end expedition with defeat
    else
        if [[card under [active card]] has tag Exit]
            // обучение (PlayerStep_Tutorial прототипа): на выходе с монетами — диалог CH_03, без них — Tutorial_NeedMoreCoins (E12)
            end expedition with victory
        else
            add -1 to turns left
            end turn
